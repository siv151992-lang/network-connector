# ---- Deployment (docker compose) ------------------------------------------
WIREMESH_DOMAIN=vpn.example.com
ACME_EMAIL=you@example.com
# openssl rand -base64 24
POSTGRES_PASSWORD=
# openssl rand -base64 32   -- BACK THIS UP: it decrypts stored TOTP secrets
WIREMESH_SECRET_KEY=
WIREMESH_VERSION=dev

# ---- Server: every WIREMESH_* variable, with defaults ----------------------
# WIREMESH_ENV=production            development | production
# WIREMESH_HTTP_ADDR=:8080
# WIREMESH_PUBLIC_URL=https://vpn.example.com   (must be https in production)
# WIREMESH_DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=disable
# WIREMESH_DB_MAX_CONNS=20
# WIREMESH_AUTO_MIGRATE=true
# WIREMESH_REDIS_URL=                only for multi-replica (Phase 11)
# WIREMESH_LOG_LEVEL=info            debug | info | warn | error
# WIREMESH_LOG_FORMAT=json           json | text
# WIREMESH_TRUSTED_PROXIES=          CIDRs whose X-Forwarded-For is trusted
# WIREMESH_CORS_ORIGINS=             only if the dashboard is on another origin
# WIREMESH_RATE_LIMIT_RPS=10
# WIREMESH_RATE_LIMIT_BURST=30
# WIREMESH_MAX_BODY_BYTES=1048576
# WIREMESH_SHUTDOWN_TIMEOUT=20s
# WIREMESH_IPV4_RANGE=100.64.0.0/10
