# Copy to deploy/.env and fill in the four required values.

# Required
WIREMESH_DOMAIN=vpn.example.com          # DNS A/AAAA record must point at this server
ACME_EMAIL=you@example.com               # for the Let's Encrypt certificate
POSTGRES_PASSWORD=                       # openssl rand -base64 24
WIREMESH_SECRET_KEY=                     # openssl rand -base64 32  (back it up!)

# Relay: after first start, run `docker compose run --rm server relay-pubkey`
# and paste the output here, then `docker compose up -d` again.
WIREMESH_RELAY_CONTROL_KEY=

# Optional
# WIREMESH_ALLOW_REGISTRATION=false
# WIREMESH_REQUIRE_EMAIL_VERIFICATION=true
# WIREMESH_SMTP_HOST=
# WIREMESH_SMTP_PORT=587
# WIREMESH_SMTP_USERNAME=
# WIREMESH_SMTP_PASSWORD=
# WIREMESH_SMTP_FROM=
# REDIS_PASSWORD=                        # only with --profile ha
