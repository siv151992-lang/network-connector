[Unit]
Description=WireMesh mesh VPN daemon
Documentation=https://github.com/siv151992-lang/network-connector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/wiremeshd --state /var/lib/wiremesh/state.json --socket /run/wiremesh/wiremeshd.sock
Restart=on-failure
RestartSec=3
StateDirectory=wiremesh
StateDirectoryMode=0700
RuntimeDirectory=wiremesh
RuntimeDirectoryMode=0755

# Least privilege: root is needed for /dev/net/tun and netlink, but only the
# network capabilities are kept, and the filesystem is read-only except the
# state/runtime directories.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_CHOWN
DeviceAllow=/dev/net/tun rw
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/run/wiremesh /var/lib/wiremesh /run/wireguard
# systemd-resolved integration for MagicDNS (resolvectl over D-Bus).
ReadWritePaths=/run/dbus

[Install]
WantedBy=multi-user.target
